
import groovy.json.JsonOutput
import groovy.json.JsonSlurper

String baseUrl = 'http://127.0.0.1:5000'
String messageId = 'msg-1001'

String body = JsonOutput.toJson([
    id: messageId,
    text: 'Hello from Katalon',
    status: 'queued'
])

def connection = new URL("${baseUrl}/messages").openConnection()
connection.setRequestMethod('POST')
connection.setConnectTimeout(5000)
connection.setReadTimeout(5000)
connection.setDoOutput(true)
connection.setRequestProperty('Content-Type', 'application/json')
connection.setRequestProperty('Accept', 'application/json')

connection.outputStream.withWriter('UTF-8') {
    it << body
}

int statusCode = connection.responseCode
def responseStream = statusCode >= 400 ?
    connection.errorStream : connection.inputStream

String responseText = responseStream.getText('UTF-8')

assert statusCode == 201 :
    "Expected HTTP 201, got ${statusCode}. Body: ${responseText}"

def response = new JsonSlurper().parseText(responseText)

assert response.id == messageId :
    "Unexpected message ID: ${response.id}"

assert response.text == 'Hello from Katalon' :
    "Unexpected message text: ${response.text}"

assert response.status == 'queued' :
    "Unexpected message status: ${response.status}"

println "PASS: REST producer created message ${response.id}"

connection.disconnect()
